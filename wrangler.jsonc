{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growth-toolkit",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "growth-audio"
    }
  ]
}
